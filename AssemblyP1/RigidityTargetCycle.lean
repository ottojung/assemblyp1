import AssemblyP1.RigidityBouquet

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

/-!
# The target-cycle bouquet and the numerical-semigroup (coin) reduction
(issue #257, scope §8.1/§8.2)

This module advances the open items **§8.1** (a checkable closed-form criterion
for general supports) and **§8.2** (exact complexity) of
`docs/source-notes/issue-257-rigid-read-graphs.md`. It builds on — and does not
redo — the merged bouquet criterion `AssemblyP1.RigidityBouquet.bouquet_nonrigid_iff`
and the exact criterion `AssemblyP1.ExactRigidityCriterion.nonrigid_iff_exists_delta`.

## The target-cycle bouquet

Fix coin cycle lengths `a 0, …, a (n-1) ≥ 1` and a **target** cycle length
`t ≥ 1`. The *target-cycle bouquet* has `n + 1` cycles through a common vertex:
the `n` coin cycles each traversed **once** (`mult = 1`) and the target cycle
traversed **twice** (`mult = 2`). Its circulation space is `ℤ^{n+1}` and the
exact criterion (`bouquet_nonrigid_iff`) reads

> not rigid ⟺ `∃ x ≠ 0, ∑ len_i x_i = 0, x_i ≥ 1 - mult_i`.

For the target-cycle bouquet the box is `x_i ≥ 0` on every coin cycle and
`x_last ≥ -1` on the target cycle, and the zero-sum equation is
`∑_i a_i x_i + t·x_last = 0`. Because `a_i > 0` and `x_i ≥ 0`, the coin part is
`≥ 0`; since `t > 0`, this forces `x_last ≤ 0`, hence `x_last ∈ {-1, 0}`. The
value `x_last = 0` forces every coin coordinate to `0` (contradicting `x ≠ 0`),
so a witness exists **iff** `x_last = -1` and `∑_i a_i x_i = t` with `x_i ≥ 0`.
That is exactly **numerical-semigroup membership**:

> **`targetCycle_nonrigid_iff_coin`**: the target-cycle bouquet is not rigid
> **iff** the target length `t` is a nonnegative integer combination of the coin
> lengths `a i`.

Equivalently, the bouquet is rigid **iff** `t ∉ ⟨a_0, …, a_{n-1}⟩`, the
numerical semigroup generated by the coin lengths. This makes the whole
"target + coins" family an exact, checkable criterion that is *precisely* the
unbounded coin / change-making problem.

## Why this is a §8.2 complexity statement, not an NP-hardness proof

The coin problem with **binary** denominations is NP-complete (Lueker 1975).
But an *explicit* support graph has one edge per unit of cycle length, so the
coin lengths are encoded in **unary** (`a i ≤ M`, the edge bound, is part of the
graph size). For unary denominations, representability is decidable in
polynomial time by the Apéry-set / residue-graph shortest-path algorithm
(`scripts/verify_257_target_cycle.py`): build the graph on `ℤ / a_min` with an
edge `r → r + a_i` of weight `a_i`, compute shortest distances from `0`, and
test `t ≥ dist (t mod a_min)`. Hence the target-cycle family — and the whole
bouquet family — is decidable in time polynomial in the explicit graph size and
the bit length of the multiplicities. The reduction therefore **refutes** the
tempting reading "the bouquet encodes an NP-hard problem for explicit supports",
and leaves the uniform-in-support complexity genuinely **OPEN** (§8.2).

## Main results

* `targetCycle_nonrigid_iff_coin`: the exact coin / numerical-semigroup reduction.
* `targetCycle_rigid_iff_not_coin`: its rigid dual.
* Kernel-checked worked instances `coin_nonrigid_23_5`, `coin_rigid_23_1`,
  `coin_rigid_33_2` (the last is the length `(2,3,3)` real/integer-gap bouquet
  re-read as a target cycle).

## Epistemic status

All theorems are kernel-checked with only `[propext, Classical.choice,
Quot.sound]` (`AssemblyP1.RigidityTargetCycleAudit`); no `sorry`/`admit`/`axiom`/
`native_decide`. The polynomial Apéry-set algorithm and the complexity analysis
are [verified computation] and [mathematical proof, cited external result] in the
source note; the general-support uniform complexity remains **OPEN**.
-/

namespace AssemblyP1.RigidityTargetCycle

open Finset BigOperators
open AssemblyP1.RigidityBouquet

variable {n : ℕ}

/-- Target-cycle length vector: `n` coin cycles of lengths `a i`, then one target
cycle of length `t` at the last index. -/
def tcLen (a : Fin n → ℕ) (t : ℕ) : Fin (n + 1) → ℕ :=
  Fin.lastCases t (fun i => a i)

/-- Target-cycle multiplicity vector (as naturals): each coin cycle once, the
target cycle twice. -/
def tcMultN (n : ℕ) : Fin (n + 1) → ℕ :=
  Fin.lastCases 2 (fun _ => 1)

/-- Target-cycle multiplicities as integers, for the bouquet criterion. -/
def tcMult (n : ℕ) : Fin (n + 1) → ℤ := fun i => (tcMultN n i : ℤ)

/-- Total mass of the target-cycle bouquet. -/
def tcG (a : Fin n → ℕ) (t : ℕ) : ℕ :=
  ∑ i : Fin (n + 1), tcLen a t i * tcMultN n i

@[simp] lemma tcLen_last (a : Fin n → ℕ) (t : ℕ) : tcLen a t (Fin.last n) = t := by
  simp [tcLen]

@[simp] lemma tcLen_castSucc (a : Fin n → ℕ) (t : ℕ) (i : Fin n) :
    tcLen a t (Fin.castSucc i) = a i := by
  simp [tcLen]

@[simp] lemma tcMultN_last (n : ℕ) : tcMultN n (Fin.last n) = 2 := by
  simp [tcMultN]

@[simp] lemma tcMultN_castSucc (n : ℕ) (i : Fin n) : tcMultN n (Fin.castSucc i) = 1 := by
  simp [tcMultN]

@[simp] lemma tcMult_last (n : ℕ) : tcMult n (Fin.last n) = 2 := by
  simp [tcMult]

@[simp] lemma tcMult_castSucc (n : ℕ) (i : Fin n) : tcMult n (Fin.castSucc i) = 1 := by
  simp [tcMult]

lemma tcLen_pos (a : Fin n → ℕ) (t : ℕ) (ha : ∀ i, 1 ≤ a i) (ht : 1 ≤ t) :
    ∀ i, 1 ≤ tcLen a t i := by
  intro i
  induction i using Fin.lastCases with
  | last => simpa using ht
  | cast j => simpa using ha j

/-- The natural total mass equals the integer weighted sum used by the bouquet
criterion. -/
lemma tcG_cast (a : Fin n → ℕ) (t : ℕ) :
    (tcG a t : ℤ) = ∑ i : Fin (n + 1), (tcLen a t i : ℤ) * tcMult n i := by
  unfold tcG tcMult
  rw [Nat.cast_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [Nat.cast_mul]

/-- The bouquet total-mass hypothesis for the target-cycle bouquet. -/
lemma tc_atot (a : Fin n → ℕ) (t : ℕ) (ha : ∀ i, 1 ≤ a i) (ht : 1 ≤ t)
    (M : ℕ) (hM : ∀ i, tcLen a t i ≤ M) :
    ∑ e ∈ bedges (tcLen a t) M, bouquetA (tcLen a t) M (tcMult n) e = (tcG a t : ℤ) := by
  rw [tcG_cast]
  exact sum_bedges_const (tcLen a t) M (tcLen_pos a t ha ht) hM
    (bouquetA (tcLen a t) M (tcMult n)) (tcMult n) (fun _ _ => rfl)

/-- **Target-cycle / coin reduction.** The target-cycle bouquet (coin cycles of
lengths `a i ≥ 1` traversed once, target cycle of length `t ≥ 1` traversed
twice) is **not** rigid **iff** `t` is a nonnegative integer combination of the
coin lengths. -/
theorem targetCycle_nonrigid_iff_coin
    (a : Fin n → ℕ) (t : ℕ) (ha : ∀ i, 1 ≤ a i) (ht : 1 ≤ t)
    (M : ℕ) (hM : ∀ i, tcLen a t i ≤ M) :
    (¬ AssemblyP1.ExactRigidityCriterion.Rigid btail bhead (bnodes (tcLen a t))
        (bedges (tcLen a t) M) (bouquetA (tcLen a t) M (tcMult n)) (tcG a t)) ↔
      ∃ y : Fin n → ℕ, ∑ i, a i * y i = t := by
  rw [bouquet_nonrigid_iff (tcLen a t) M (tcLen_pos a t ha ht) hM (tcMult n) (tcG a t)
      (tc_atot a t ha ht M hM)]
  constructor
  · rintro ⟨x, hxne, hxsum, hxbox⟩
    -- Coin coordinates are nonnegative; the target coordinate is `≥ -1`.
    have hcoin : ∀ i : Fin n, 0 ≤ x (Fin.castSucc i) := by
      intro i
      have h := hxbox (Fin.castSucc i)
      simp only [tcMult_castSucc] at h
      linarith
    have hlast : (-1 : ℤ) ≤ x (Fin.last n) := by
      have h := hxbox (Fin.last n)
      simp only [tcMult_last] at h
      linarith
    -- Split the zero-sum equation into coin part and target part.
    have hsum' : (∑ i : Fin n, (a i : ℤ) * x (Fin.castSucc i))
        + (t : ℤ) * x (Fin.last n) = 0 := by
      have h := hxsum
      rw [Fin.sum_univ_castSucc] at h
      simpa only [tcLen_castSucc, tcLen_last] using h
    have hS_nonneg : 0 ≤ ∑ i : Fin n, (a i : ℤ) * x (Fin.castSucc i) := by
      apply Finset.sum_nonneg
      intro i _
      have hai : (0 : ℤ) ≤ (a i : ℤ) := by have := ha i; omega
      exact mul_nonneg hai (hcoin i)
    have htpos : (0 : ℤ) < (t : ℤ) := by have := ht; omega
    -- The target coordinate is `≤ 0`, hence in `{-1, 0}`.
    have hlast_le : x (Fin.last n) ≤ 0 := by
      have h : (t : ℤ) * x (Fin.last n) ≤ 0 := by linarith
      nlinarith [htpos]
    -- Rule out `x_last = 0`: then every coin coordinate vanishes and `x = 0`.
    have hlast_ne : x (Fin.last n) ≠ 0 := by
      intro h0
      apply hxne
      funext i
      induction i using Fin.lastCases with
      | last => simpa using h0
      | cast j =>
        have hSj : (a j : ℤ) * x (Fin.castSucc j) = 0 := by
          have hsum0 : ∑ i : Fin n, (a i : ℤ) * x (Fin.castSucc i) = 0 := by
            have := hsum'; rw [h0, mul_zero, add_zero] at this; exact this
          exact (Finset.sum_eq_zero_iff_of_nonneg
            (fun i _ => by
              have hai : (0 : ℤ) ≤ (a i : ℤ) := by have := ha i; omega
              exact mul_nonneg hai (hcoin i))).mp hsum0 j (Finset.mem_univ j)
        have haj : (a j : ℤ) ≠ 0 := by have := ha j; omega
        exact mul_eq_zero.mp hSj |>.resolve_left haj
    have hlast_eq : x (Fin.last n) = -1 := by omega
    refine ⟨fun i => (x (Fin.castSucc i)).toNat, ?_⟩
    apply Nat.cast_injective (R := ℤ)
    rw [Nat.cast_sum]
    simp only [Nat.cast_mul]
    have hS_eq : ∑ i : Fin n, (a i : ℤ) * x (Fin.castSucc i) = (t : ℤ) := by
      have := hsum'; rw [hlast_eq] at this
      linarith
    have hcast : (∑ i : Fin n, (a i : ℤ) * ((x (Fin.castSucc i)).toNat : ℤ))
        = ∑ i : Fin n, (a i : ℤ) * x (Fin.castSucc i) :=
      Finset.sum_congr rfl (fun i _ => by rw [Int.toNat_of_nonneg (hcoin i)])
    exact hcast.trans hS_eq
  · rintro ⟨y, hy⟩
    refine ⟨fun i => Fin.lastCases (-1) (fun j => (y j : ℤ)) i, ?_, ?_, ?_⟩
    · intro hx0
      have h := congrFun hx0 (Fin.last n)
      simp at h
    · have hsplit : (∑ i : Fin (n + 1),
          (tcLen a t i : ℤ) * (Fin.lastCases (-1) (fun j => (y j : ℤ)) i))
          = (∑ j : Fin n, (a j : ℤ) * (y j : ℤ)) + (t : ℤ) * (-1) := by
        rw [Fin.sum_univ_castSucc]
        simp only [tcLen_castSucc, tcLen_last]
        congr 1
        · apply Finset.sum_congr rfl
          intro j _
          simp
        · simp
      rw [hsplit]
      have hy' : (∑ j : Fin n, (a j : ℤ) * (y j : ℤ)) = (t : ℤ) := by
        have hcast : (∑ j : Fin n, (a j : ℤ) * (y j : ℤ))
            = ((∑ j : Fin n, a j * y j : ℕ) : ℤ) := by
          rw [Nat.cast_sum]
          apply Finset.sum_congr rfl
          intro j _
          rw [Nat.cast_mul]
        rw [hcast, hy]
      rw [hy']
      ring
    · intro i
      induction i using Fin.lastCases with
      | last => simp
      | cast j => simp

/-- **Rigid dual.** The target-cycle bouquet is rigid **iff** `t` is not a
nonnegative integer combination of the coin lengths. -/
theorem targetCycle_rigid_iff_not_coin
    (a : Fin n → ℕ) (t : ℕ) (ha : ∀ i, 1 ≤ a i) (ht : 1 ≤ t)
    (M : ℕ) (hM : ∀ i, tcLen a t i ≤ M) :
    AssemblyP1.ExactRigidityCriterion.Rigid btail bhead (bnodes (tcLen a t))
        (bedges (tcLen a t) M) (bouquetA (tcLen a t) M (tcMult n)) (tcG a t) ↔
      ¬ ∃ y : Fin n → ℕ, ∑ i, a i * y i = t := by
  rw [← targetCycle_nonrigid_iff_coin a t ha ht M hM]
  constructor
  · intro h hnr; exact hnr h
  · intro h; by_contra hnr; exact h hnr

/-! ## Kernel-checked worked instances -/

/-- Coin cycles of lengths `2, 3`. -/
def coin23 : Fin 2 → ℕ := fun i => if i = 0 then 2 else 3

/-- Coin cycles of lengths `3, 3`. -/
def coin33 : Fin 2 → ℕ := fun _ => 3

/-- **Non-rigid coin instance.** Coins `(2,3)`, target `5 = 2 + 3`: the target is
representable, so the target-cycle bouquet is not rigid. -/
theorem coin_nonrigid_23_5 :
    ¬ AssemblyP1.ExactRigidityCriterion.Rigid btail bhead (bnodes (tcLen coin23 5))
        (bedges (tcLen coin23 5) 6) (bouquetA (tcLen coin23 5) 6 (tcMult 2))
        (tcG coin23 5) := by
  rw [targetCycle_nonrigid_iff_coin coin23 5 (by decide) (by decide) 6 (by decide)]
  exact ⟨fun _ => 1, by decide⟩

/-- **Rigid coin instance.** Coins `(2,3)`, target `1`: the target is not
representable (`2 x + 3 y = 1` has no nonnegative solution), so the
target-cycle bouquet is rigid. -/
theorem coin_rigid_23_1 :
    AssemblyP1.ExactRigidityCriterion.Rigid btail bhead (bnodes (tcLen coin23 1))
        (bedges (tcLen coin23 1) 3) (bouquetA (tcLen coin23 1) 3 (tcMult 2))
        (tcG coin23 1) := by
  rw [targetCycle_rigid_iff_not_coin coin23 1 (by decide) (by decide) 3 (by decide)]
  rintro ⟨y, hy⟩
  norm_num [coin23, Fin.sum_univ_two] at hy
  omega

/-- **Rigid coin instance (real/integer-gap bouquet re-read).** Coins `(3,3)`,
target `2`: not representable, so rigid. This is the length `(2,3,3)`,
multiplicity `(2,1,1)` bouquet of `AssemblyP1.RigidityBouquet.len233_mult211_real_integer_gap`
re-read with the length-`2` cycle as the target; that bouquet is
genome-realizable (see `AssemblyP1/RigidityBouquetGenomeWitness.lean`). -/
theorem coin_rigid_33_2 :
    AssemblyP1.ExactRigidityCriterion.Rigid btail bhead (bnodes (tcLen coin33 2))
        (bedges (tcLen coin33 2) 3) (bouquetA (tcLen coin33 2) 3 (tcMult 2))
        (tcG coin33 2) := by
  rw [targetCycle_rigid_iff_not_coin coin33 2 (by decide) (by decide) 3 (by decide)]
  rintro ⟨y, hy⟩
  simp only [Fin.sum_univ_two, coin33] at hy
  omega

end AssemblyP1.RigidityTargetCycle
