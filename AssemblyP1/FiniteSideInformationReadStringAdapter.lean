import Mathlib
import AssemblyP1.FiniteBayesianSideInformation
import AssemblyP1.FiniteSideInformationOrder
import AssemblyP1.FiniteSideInformationSourcePromise
import AssemblyP1.HistoricalCovers
import AssemblyP1.SourceFaithfulIs
import AssemblyP1.FiniteSamplingCounterexample

/-!
# The literal read-string adapter for the read-dependent `I_s` family (#272)

This module discharges the first of the two concrete obligations left OPEN by the
merged `#272` order-theoretic modules:

* `AssemblyP1.FiniteBayesianSideInformation` (PR #195, `b0a6e9f`) fixed the
  exact posterior semantics `π g · p_g(r) · 1_E(g,r)` and the structural
  predicate `Sufficient`.
* `AssemblyP1.FiniteSideInformationOrder` (PR #204, `c312cbbc`) reduced, for any
  equivalence-closed admissible family `Adm`, the question "does a weakest
  (least informative) sufficient promise exist?" to the single obligation
  `Adm (unionAdmissible Adm π p orbit) ∧ Sufficient (unionAdmissible Adm π p orbit)`
  (`weakest_admissible_iff_union`).
* `AssemblyP1.FiniteSideInformationSourcePromise` (PR #262, `654ed0c`) resolved
  that obligation for the *truth-only* source-property family `AdmTruthOnly`.

What remained OPEN was the **read-dependent** source-defined bridging subfamily
generated by the source predicate `I_s`: the source event `I_s(S, R)` is a
property of the candidate genome `S` and the *sampled start set* `R`, while the
observed data are read *strings*.  The placement/string gap analysed in
`AssemblyP1.ConditionalIdentifiability` (#266) requires the source event to be
expressed at the placement level and marginalised over the placements
compatible with the observed read-string set, not read as a function of a
single observation type.

The present module builds that **literal read-string adapter** and proves:

1. **The adapter** (`isPromiseReadString`): candidate genome `S` promises the
   observation `Y` (a set of distinct read strings) iff some sampled start set
   `R` on `S` induces exactly `Y` and is literal-`I_s`-feasible at `(L, R)`.
   This is the placement-level source event marginalised over compatible
   placements; the observation type is the distinct read-string set
   `Finset (Fin L → α)`.
2. **Read-dependence** (`ReadDependence`): the adapter promise is neither
   read-only (`¬ AdmReadOnly`) nor truth-only (`¬ AdmTruthOnly`) on a concrete
   length-`4` model — it genuinely depends on both the candidate and the
   observation, so it lies outside both families for which the merged
   weakest-promise theorems hold.
3. **The union criterion applied** (`Family`): for the read-dependent `I_s`
   family `AdmReadStringIS` generated by the adapter, a weakest admissible
   sufficient promise exists **iff** the adapter promise is sufficient
   (`weakest_readStringIS_iff_sufficient`).  The sufficiency of the adapter
   promise is the external Not-So-Greedy premise; the fibre-uniqueness bridge
   (`sufficient_readStringIS_of_fibreUnique`, `weakest_readStringIS_of_fibreUnique`)
   takes that premise directly and is proved from it, not from the source
   algorithm.  The concrete decoder-level certainty endpoint (a read-only decoder
   `A` with the attributed guarantee, concluding conditional posterior one via
   the merged `fibreUnique_of_decoder` / `conditional_certain_of_fibreUnique`
   chain) is supplied separately by
   `AssemblyP1.FiniteSideInformationDecoderEndpoint`.
4. **The `I_s` necessity obstructions** (§4): historical coverage, all-bridged
   literal triple repeats, and bridged interleaved pairs are each *necessary*
   for the literal historical `I_s` (general projection lemmas), and the
   concrete unbridged-triple witnesses `ABXABYABZ` / `ABXABZABY` (length `9`,
   read length `4`, starts `{0,3,6}`) kernel-check that the triple-bridging
   clause is necessary: coverage holds, the length-`2` repeat `AB` is a maximal
   triple occurrence at the three distinct starts `0, 3, 6`, no read straddles
   any copy, so the literal `I_s` fails.

Nothing here asserts the external Shomorony--Kim--Courtade--Tse Not-So-Greedy
theorem; the external decoder guarantee remains an attributed premise.  No
`axiom`, `sorry`, or `admit` is introduced; the axiom audit is
`AssemblyP1/FiniteSideInformationReadStringAdapterAudit.lean`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace AssemblyP1.FiniteSideInformationReadStringAdapter

open AssemblyP1.FiniteBayesianSideInformation
open AssemblyP1.FiniteSideInformationOrder
open AssemblyP1.FiniteSideInformationSourcePromise
open AssemblyP1.HistoricalCovers
open AssemblyP1.SourceFaithfulIs

/-! ## 1. The literal read-string adapter -/

/-- **The literal read-string adapter** for the source predicate `I_s` (the
literal §6.4 predicate `HistoricalInformationFeasibleLiteral`): a candidate
genome `S` promises the observation `Y` — a set of distinct read strings — iff
some sampled start set `R` on `S` induces exactly the observed read-string set
`Y` and is `I_s`-feasible at `(L, R)`.

This is the placement-level source event `E(g, R)` marginalised over the
placements `R` compatible with the observed read-string set, exactly as
`AssemblyP1.ConditionalIdentifiability` (#266) requires: the promise is a joint
property of the candidate and the observation, not a function of either alone.
The observation type is the distinct read-string set `Finset (Fin L → α)`,
matching the source's deduplication preprocessing. -/
def isPromiseReadString {α : Type*} [DecidableEq α] (S : Genome α) (L : ℕ)
    (Y : Finset (Fin L → α)) : Prop :=
  ∃ R : Finset (Fin S.len),
    observedTypes_ofFinset S L R = Y ∧ HistoricalInformationFeasibleLiteral S L R

/-- The circular genome carried by a length-`n` spelling. -/
def toGenome {α : Type*} {n : ℕ} (hn : 0 < n) (w : Fin n → α) : Genome α where
  len := n
  len_pos := hn
  sym := w

/-- The literal read-string adapter at the spelling level: spelling `w` promises
read-string set `Y` iff some start set induces exactly `Y` and is
literal-`I_s`-feasible. -/
def isPromiseReadStringSpelling {α : Type*} [DecidableEq α] (n L : ℕ) (hn : 0 < n)
    (w : Fin n → α) (Y : Finset (Fin L → α)) : Prop :=
  isPromiseReadString (toGenome hn w) L Y

/-- The read-dependent `I_s` family generated by the literal read-string adapter:
the promises pointwise equivalent to the adapter promise.  Up to logical
equivalence this is the singleton family `{isPromiseReadStringSpelling}`; the
union criterion below shows that its only candidate for a weakest member is the
adapter promise itself. -/
def AdmReadStringIS {α : Type*} [DecidableEq α] (n L : ℕ) (hn : 0 < n)
    (E : (Fin n → α) → Finset (Fin L → α) → Prop) : Prop :=
  ∀ w Y, E w Y ↔ isPromiseReadStringSpelling n L hn w Y

/-! ## 2. The read-dependent `I_s` family and the union criterion -/

section Family

variable {α : Type*} [DecidableEq α] [Fintype α]
variable {Θ : Type*} [Fintype Θ] [DecidableEq Θ]

/-- The read-string adapter family is closed under pointwise logical
equivalence. -/
theorem admReadStringIS_congr {n L : ℕ} {hn : 0 < n}
    {E E' : (Fin n → α) → Finset (Fin L → α) → Prop}
    (heq : ∀ w Y, E w Y ↔ E' w Y) (hE : AdmReadStringIS n L hn E) :
    AdmReadStringIS n L hn E' :=
  fun w Y => (heq w Y).symm.trans (hE w Y)

/-- The adapter promise is a member of its own family. -/
theorem admReadStringIS_self {n L : ℕ} {hn : 0 < n} :
    AdmReadStringIS (α := α) n L hn
      (isPromiseReadStringSpelling (α := α) n L hn) :=
  fun _ _ => Iff.rfl

variable {n L : ℕ} {hn : 0 < n}
variable (π : (Fin n → α) → ℝ) (p : (Fin n → α) → Finset (Fin L → α) → ℝ)
variable (orbit : (Fin n → α) → Θ)

/-- The union of all admissible sufficient promises in the read-dependent `I_s`
family is pointwise equivalent to the adapter promise, **provided the adapter
promise is sufficient**.  Without sufficiency the union is the empty promise (no
admissible promise is sufficient, since all are equivalent to the adapter), so
this equivalence is exactly the sufficiency premise. -/
theorem unionAdmissible_readStringIS_iff
    (hS : Sufficient π p orbit (isPromiseReadStringSpelling n L hn)) :
    ∀ w Y, unionAdmissible (AdmReadStringIS n L hn) π p orbit w Y ↔
      isPromiseReadStringSpelling n L hn w Y := by
  intro w Y
  constructor
  · rintro ⟨E, hEadm, _, hEwY⟩
    exact (hEadm w Y).mp hEwY
  · intro hY
    exact ⟨isPromiseReadStringSpelling n L hn, admReadStringIS_self (α := α), hS, hY⟩

/-- **Weakest sufficient promise in the read-dependent `I_s` read-string
family.**  A weakest admissible sufficient promise exists **iff** the adapter
promise is sufficient.  When it exists, the adapter promise itself is the
weakest member (it is admissible, sufficient, and implied by every admissible
sufficient promise, since every such promise is pointwise equivalent to it).

The sufficiency of the adapter promise is the external Not-So-Greedy premise
(§3), not proved here; this theorem is the exact reduction of the merged
`weakest_admissible_iff_union` criterion to that premise. -/
theorem weakest_readStringIS_iff_sufficient :
    (∃ W, IsWeakestAdmissible (AdmReadStringIS n L hn) π p orbit W) ↔
      Sufficient π p orbit (isPromiseReadStringSpelling n L hn) := by
  have hcrit := weakest_admissible_iff_union (AdmReadStringIS n L hn)
    (fun {E E'} heq hE => admReadStringIS_congr heq hE) π p orbit
  constructor
  · rintro ⟨W, hW⟩
    obtain ⟨hAdmW, hSW, _⟩ := hW
    exact (sufficient_congr π p orbit (fun w Y => hAdmW w Y)).mp hSW
  · intro hS
    refine hcrit.mp ⟨?_, ?_⟩
    · intro w Y
      exact unionAdmissible_readStringIS_iff π p orbit hS w Y
    · exact (sufficient_congr π p orbit
        (fun w Y => unionAdmissible_readStringIS_iff π p orbit hS w Y)).mpr hS

/-! ## 3. Bridge to the external Not-So-Greedy premise -/

/-- **Feasible-fibre uniqueness for the adapter promise implies sufficiency.**
If any two candidates promising the same observation lie in one orbit — the
exact #266 chain of `fibreUnique_of_decoder` / `conditional_certain_of_fibreUnique`
instantiated on the read-string adapter — then the adapter promise is
sufficient.  The hypothesis is the published Not-So-Greedy guarantee and is
**not** proved here. -/
theorem sufficient_readStringIS_of_fibreUnique
    (hF : ∀ w v Y, isPromiseReadStringSpelling n L hn w Y →
      isPromiseReadStringSpelling n L hn v Y → orbit w = orbit v) :
    Sufficient π p orbit (isPromiseReadStringSpelling n L hn) := by
  intro w Y _ _ hwY v _ _ hvY
  exact (hF w v Y hwY hvY).symm

/-- **Combined bridge.**  Feasible-fibre uniqueness for the adapter promise (the
external Not-So-Greedy premise) implies a weakest admissible sufficient promise
exists in the read-dependent `I_s` read-string family. -/
theorem weakest_readStringIS_of_fibreUnique
    (hF : ∀ w v Y, isPromiseReadStringSpelling n L hn w Y →
      isPromiseReadStringSpelling n L hn v Y → orbit w = orbit v) :
    ∃ W, IsWeakestAdmissible (AdmReadStringIS n L hn) π p orbit W :=
  (weakest_readStringIS_iff_sufficient π p orbit).mpr
    (sufficient_readStringIS_of_fibreUnique π p orbit hF)

end Family

/-! ## 4. The adapter promise is read-dependent

On a concrete length-`4` model over the four-symbol alphabet `Base`, the adapter
promise is neither read-only nor truth-only: it depends on both the candidate
and the observation.  This places it outside `AdmReadOnly` (for which the merged
read-only weakest-promise theorem holds) and outside `AdmTruthOnly` (the #262
family). -/

namespace ReadDependence

open AssemblyP1.FiniteSamplingCounterexample

/-- A length-`4` circular genome over `Base`. -/
abbrev Sp4 : Type := Fin 4 → Base

/-- The circular genome carried by a length-`4` spelling. -/
def toGenome4 (w : Sp4) : Genome Base where
  len := 4
  len_pos := by norm_num
  sym := w

/-- The literal read-string adapter at the spelling level (length `4`, read
length `2`). -/
def adapter4 (w : Sp4) (Y : Finset (Fin 2 → Base)) : Prop :=
  isPromiseReadString (toGenome4 w) 2 Y

/-- The all-distinct spelling `ABCG`, whose length-`2` windows are
`AB, BC, CG, GA`. -/
def spellABCG : Sp4 := ![Base.A, Base.B, Base.C, Base.G]

/-- The all-`A` spelling `AAAA`. -/
def spellAAAA : Sp4 := ![Base.A, Base.A, Base.A, Base.A]

/-- The full read-string set of `ABCG` at read length `2`, sampled at every
start. -/
def Yall : Finset (Fin 2 → Base) :=
  observedTypes_ofFinset (toGenome4 spellABCG) 2 Finset.univ

/-- The single read string `AB`. -/
def readAB : Fin 2 → Base := ![Base.A, Base.B]

/-- The singleton read-string set `{AB}`. -/
def Yone : Finset (Fin 2 → Base) := {readAB}

/-- `ABCG` promises its full read-string set `{AB, BC, CG, GA}`: the start set
`univ` induces exactly it, and the literal `I_s` holds because `ABCG` has no
repeat at all (its symbols are pairwise distinct), so the triple and interleaved
clauses are vacuous while string coverage is saturated. -/
theorem spellABCG_promises_Yall : adapter4 spellABCG Yall := by
  refine ⟨Finset.univ, ?_, ?_⟩
  · rfl
  · decide

/-- `AAAA` cannot promise `{AB, BC, CG, GA}`: every window of `AAAA` is `AA`, so
no start set induces the four-element set `Yall`. -/
theorem spellAAAA_not_promises_Yall : ¬ adapter4 spellAAAA Yall := by
  unfold adapter4 isPromiseReadString
  decide

/-- `ABCG` cannot promise the singleton `{AB}`: the only start set inducing
`{AB}` is `{0}`, at which historical coverage fails (position `1` is not within
`L-1 = 1` of a matching start). -/
theorem spellABCG_not_promises_Yone : ¬ adapter4 spellABCG Yone := by
  unfold adapter4 isPromiseReadString
  decide

/-- **The adapter promise is not read-only.**  At the same observation `Yall`,
the spelling `ABCG` promises it while `AAAA` does not, so the promise is not a
function of the observation alone. -/
theorem not_readOnly : ¬ AdmReadOnly adapter4 := by
  intro h
  exact spellAAAA_not_promises_Yall
    ((h spellABCG spellAAAA Yall).mp spellABCG_promises_Yall)

/-- **The adapter promise is not truth-only.**  The spelling `ABCG` promises
`Yall` but not the singleton `Yone`, so the promise is not a function of the
candidate alone. -/
theorem not_truthOnly : ¬ AdmTruthOnly adapter4 := by
  intro h
  exact spellABCG_not_promises_Yone
    ((h spellABCG Yall Yone).mp spellABCG_promises_Yall)

/-- **The adapter promise is read-dependent.**  It is neither read-only nor
truth-only: it depends jointly on the candidate and the observation. -/
theorem readDependent : ¬ AdmReadOnly adapter4 ∧ ¬ AdmTruthOnly adapter4 :=
  ⟨not_readOnly, not_truthOnly⟩

end ReadDependence

/-! ## 5. The `I_s` necessity obstructions -/

/- The three clauses of the literal historical `I_s` are each necessary: none can
be dropped.  The general projection lemmas below make the necessity explicit;
the concrete unbridged-triple witnesses `ABXABYABZ` / `ABXABZABY` kernel-check
that the triple-bridging clause is necessary. -/

/-- **Coverage necessity (general).**  Historical coverage of the observed read
types is a necessary condition for the literal historical `I_s`. -/
theorem historicalLiteral_coverage {α : Type*} [DecidableEq α] {S : Genome α} {L : ℕ}
    {R : Finset (Fin S.len)} (h : HistoricalInformationFeasibleLiteral S L R) :
    HistoricalCovers S L (observedTypes_ofFinset S L R) :=
  h.1

/-- **Triple-bridging necessity (general).**  Every literal three-occurrence
repeat is all-bridged whenever the literal historical `I_s` holds. -/
theorem historicalLiteral_tripleBridged {α : Type*} [DecidableEq α] {S : Genome α}
    {L : ℕ} {R : Finset (Fin S.len)} (h : HistoricalInformationFeasibleLiteral S L R)
    (e : Fin S.len) (a b c : Fin S.len) (hocc : IsTripleOccurrence S e.val a b c) :
    IsTripleRepeatAllBridged S L (MatchStarts S L (observedTypes_ofFinset S L R)) e.val a b c :=
  h.2.1 e a b c hocc

/-- **Interleaved-bridging necessity (general).**  Every interleaved pair of
repeats is bridged whenever the literal historical `I_s` holds. -/
theorem historicalLiteral_interleavedBridged {α : Type*} [DecidableEq α] {S : Genome α}
    {L : ℕ} {R : Finset (Fin S.len)} (h : HistoricalInformationFeasibleLiteral S L R)
    (e₁ e₂ : Fin S.len) (a b c d : Fin S.len) (h₁ : S.IsRepeat e₁.val a b)
    (h₂ : S.IsRepeat e₂.val c d) (h₃ : Interleaved S a b c d) :
    IsInterleavedPairBridged S L (MatchStarts S L (observedTypes_ofFinset S L R))
      e₁.val e₂.val a b c d :=
  h.2.2 e₁ e₂ a b c d h₁ h₂ h₃

/-! ### Concrete unbridged-triple witnesses `ABXABYABZ` / `ABXABZABY` -/

/- Both genomes have length `9` and carry the length-`2` repeat `AB` at the three
distinct starts `0, 3, 6`.  With read length `4` and sampled starts `{0,3,6}`,
historical coverage holds but no read straddles any copy of the triple (a read
of length `4` bridges the length-`2` copy at `t` only from start `t-1`, and
`8, 2, 5 ∉ {0,3,6}`), so the triple is not all-bridged and the literal `I_s`
fails.  The two witnesses differ in the following symbols (`X,Y,Z` vs `X,Z,Y`),
showing the obstruction is robust across flanking contexts. -/

namespace UnbridgedTriple

/-- A five-symbol alphabet containing the witness symbols. -/
inductive Nuc5 where
  | A | B | X | Y | Z
  deriving DecidableEq, Inhabited, Repr

instance : Fintype Nuc5 where
  elems := {Nuc5.A, Nuc5.B, Nuc5.X, Nuc5.Y, Nuc5.Z}
  complete := by intro x; cases x <;> simp

/-- The circular genome `ABXABYABZ` of length `9`. -/
abbrev genomeABXABYABZ : Genome Nuc5 where
  len := 9
  len_pos := by norm_num
  sym := ![Nuc5.A, Nuc5.B, Nuc5.X, Nuc5.A, Nuc5.B, Nuc5.Y, Nuc5.A, Nuc5.B, Nuc5.Z]

/-- The circular genome `ABXABZABY` of length `9`. -/
abbrev genomeABXABZABY : Genome Nuc5 where
  len := 9
  len_pos := by norm_num
  sym := ![Nuc5.A, Nuc5.B, Nuc5.X, Nuc5.A, Nuc5.B, Nuc5.Z, Nuc5.A, Nuc5.B, Nuc5.Y]

/-- The sampled start set `{0, 3, 6}`. -/
def starts936 : Finset (Fin 9) := {0, 3, 6}

/-- In `ABXABYABZ`, the length-`2` windows at `0`, `3`, `6` agree pairwise: a
literal three-occurrence repeat. -/
theorem abxab_tripleOccurrence : IsTripleOccurrence genomeABXABYABZ 2 0 3 6 := by
  decide

/-- In `ABXABYABZ`, the preceding symbols `Z, X, Y` and the following symbols
`X, Y, Z` are not all equal, so the triple occurrence is a maximal triple
repeat. -/
theorem abxab_tripleRepeat : genomeABXABYABZ.IsTripleRepeat 2 0 3 6 := by
  decide

/-- In `ABXABYABZ`, historical coverage holds at read length `4` with the
observed read types induced by `{0,3,6}`: every position lies within `L-1 = 3`
of a match start. -/
theorem abxab_covers :
    HistoricalCovers genomeABXABYABZ 4 (observedTypes_ofFinset genomeABXABYABZ 4 starts936) := by
  decide

/-- In `ABXABYABZ`, the triple repeat is **not** all-bridged at read length `4`
with the saturated match starts: a length-`4` read bridges the length-`2` copy at
`t` only from start `t-1`, and `8, 2, 5 ∉ {0,3,6}`. -/
theorem abxab_not_allBridged :
    ¬ IsTripleRepeatAllBridged genomeABXABYABZ 4
      (MatchStarts genomeABXABYABZ 4 (observedTypes_ofFinset genomeABXABYABZ 4 starts936))
      2 0 3 6 := by
  decide

/-- **The literal `I_s` fails on `ABXABYABZ`.**  Coverage holds and the triple
occurrence is maximal, but the triple is not all-bridged, so the literal
historical `I_s` fails: the triple-bridging clause is necessary. -/
theorem abxab_not_feasible :
    ¬ HistoricalInformationFeasibleLiteral genomeABXABYABZ 4 starts936 := by
  intro h
  exact abxab_not_allBridged
    (historicalLiteral_tripleBridged h ⟨2, by norm_num⟩ 0 3 6 abxab_tripleOccurrence)

/-- In `ABXABZABY`, the length-`2` windows at `0`, `3`, `6` agree pairwise. -/
theorem abxabz_tripleOccurrence : IsTripleOccurrence genomeABXABZABY 2 0 3 6 := by
  decide

/-- In `ABXABZABY`, the triple occurrence is a maximal triple repeat. -/
theorem abxabz_tripleRepeat : genomeABXABZABY.IsTripleRepeat 2 0 3 6 := by
  decide

/-- In `ABXABZABY`, historical coverage holds at read length `4`. -/
theorem abxabz_covers :
    HistoricalCovers genomeABXABZABY 4 (observedTypes_ofFinset genomeABXABZABY 4 starts936) := by
  decide

/-- In `ABXABZABY`, the triple repeat is **not** all-bridged. -/
theorem abxabz_not_allBridged :
    ¬ IsTripleRepeatAllBridged genomeABXABZABY 4
      (MatchStarts genomeABXABZABY 4 (observedTypes_ofFinset genomeABXABZABY 4 starts936))
      2 0 3 6 := by
  decide

/-- **The literal `I_s` fails on `ABXABZABY`.** -/
theorem abxabz_not_feasible :
    ¬ HistoricalInformationFeasibleLiteral genomeABXABZABY 4 starts936 := by
  intro h
  exact abxabz_not_allBridged
    (historicalLiteral_tripleBridged h ⟨2, by norm_num⟩ 0 3 6 abxabz_tripleOccurrence)

/-- **Combined necessity witness.**  On both concrete genomes, coverage holds,
the length-`2` repeat `AB` is a maximal triple occurrence at starts `0, 3, 6`,
the triple is not all-bridged, and the literal historical `I_s` fails. -/
theorem unbridged_triple_witness :
    (HistoricalCovers genomeABXABYABZ 4 (observedTypes_ofFinset genomeABXABYABZ 4 starts936) ∧
      genomeABXABYABZ.IsTripleRepeat 2 0 3 6 ∧
      ¬ HistoricalInformationFeasibleLiteral genomeABXABYABZ 4 starts936) ∧
      (HistoricalCovers genomeABXABZABY 4 (observedTypes_ofFinset genomeABXABZABY 4 starts936) ∧
        genomeABXABZABY.IsTripleRepeat 2 0 3 6 ∧
        ¬ HistoricalInformationFeasibleLiteral genomeABXABZABY 4 starts936) :=
  ⟨⟨abxab_covers, abxab_tripleRepeat, abxab_not_feasible⟩,
    ⟨abxabz_covers, abxabz_tripleRepeat, abxabz_not_feasible⟩⟩

end UnbridgedTriple

end AssemblyP1.FiniteSideInformationReadStringAdapter
